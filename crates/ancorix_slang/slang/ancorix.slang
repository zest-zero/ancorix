// The whole library behind one `import ancorix;`.
//
// Split into modules so that each stays readable, re-exported here so that a
// shader never has to know which file a function came from.

__exported import color;
__exported import distort;
__exported import ease;
__exported import gradient;
__exported import noise;
__exported import pattern;
__exported import shape;
__exported import shapes;
__exported import surface;
